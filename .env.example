# 0xClaw Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# === PRIMARY INFERENCE (FLock.io — Gold Sponsor) ===
# Get your key at: https://platform.flock.io
FLOCK_API_KEY=sk-your-flock-api-key

# === PRIVACY INFERENCE (Venice.ai — Silver Sponsor) ===
# Get your key at: https://venice.ai/settings/api
VENICE_API_KEY=your-venice-api-key

# === BLOCKCHAIN (Virtuals Protocol — Bronze Sponsor) ===
# Get from: https://game.virtuals.io (GAME Console → New Project → API Key)
VIRTUALS_API_KEY=your-virtuals-game-api-key

# === ON-CHAIN MEMORY (Unibase — Bronze Sponsor) ===
# Register at: https://unibase.io (requires BNB testnet wallet)
MEMBASE_ID=0xclaw-main
MEMBASE_ACCOUNT=your-bnb-wallet-address
MEMBASE_SECRET_KEY=your-membase-secret-key

# === FALLBACK LLM (Anthropic) ===
# Only needed if you want Claude as fallback
ANTHROPIC_API_KEY=sk-ant-your-key

# === WEB SEARCH (optional but recommended) ===
# Get from: https://api.search.brave.com
BRAVE_API_KEY=your-brave-search-api-key
