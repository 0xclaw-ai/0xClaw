# 0xClaw Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# === PRIMARY INFERENCE (Z.ai — Gold Sponsor) ===
# International API: https://api.z.ai/api/paas/v4
# Get your key at: https://z.ai/model-api
ZAI_API_KEY=your-zai-api-key

# === SECONDARY INFERENCE (FLock.io — Gold Sponsor) ===
# Get your key at: https://platform.flock.io
FLOCK_API_KEY=sk-your-flock-api-key

# === WEB SEARCH (optional) ===
# Get from: https://api.search.brave.com
BRAVE_API_KEY=your-brave-search-api-key

# === FIRECRAWL (research-phase multi-hop crawling) ===
# Powers the hackathon-research skill — scrapes sponsor blogs, starter READMEs,
# and SDK docs via the firecrawl-mcp server. Without this key the research
# phase falls back to plain web_fetch.
# Get from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# === CLAUDE CODE (no API key required here) ===
# Phase 5 (coding) and Phase 6 (testing) can route through Claude Code via the
# official `claude-agent-sdk`. Install and log in once:
#   npm install -g @anthropic-ai/claude-code
#   claude
# Then leave `subagents.{coding,testing}.backend = "claude_code"` in
# `0xclaw/config/config.json` (default).

# === E2B SANDBOX (Phase 6 testing) ===
# Phase 6 (testing) runs install + smoke-tests inside an ephemeral E2B microVM
# so generated projects do not pollute the host conda env. If unset, Phase 6
# falls back to running on the host with a warning.
# Get from: https://e2b.dev
E2B_API_KEY=your-e2b-api-key

# === GATEWAY ===
TELEGRAM_BOT_TOKEN=your-token
