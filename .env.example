# 0xClaw Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# === PRIMARY INFERENCE (Zhipu GLM-5) ===
# Get your key at: https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=your-zhipu-api-key

# === PRIMARY INFERENCE (FLock.io — Gold Sponsor) ===
# Get your key at: https://platform.flock.io
FLOCK_API_KEY=sk-your-flock-api-key

# === FALLBACK INFERENCE (OpenRouter — temporary until FLock budget is fixed) ===
# Get your key at: https://openrouter.ai/keys (format: sk-or-...)
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# === WEB SEARCH (optional) ===
# Get from: https://api.search.brave.com
BRAVE_API_KEY=your-brave-search-api-key

# === OBSERVABILITY (Anyway tracing, optional) ===
# Dashboard/docs: https://anyway.mintlify.app
ANYWAY_API_KEY=your-anyway-api-key
ANYWAY_API_ENDPOINT=https://trace-dev-collector.anyway.sh/
ANYWAY_APP_NAME=0xclaw
# Keep false unless your collector supports /v1/metrics
ANYWAY_METRICS_ENABLED=false
