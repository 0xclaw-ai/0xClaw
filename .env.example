# 0xClaw Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# === PRIMARY INFERENCE (FLock.io — Gold Sponsor) ===
# Get your key at: https://platform.flock.io
FLOCK_API_KEY=sk-your-flock-api-key

# === WEB SEARCH (optional) ===
# Get from: https://api.search.brave.com
BRAVE_API_KEY=your-brave-search-api-key

# === SPONSOR TOOLS (optional — only needed when running the generated project) ===
# Virtual Protocol: https://game.virtuals.io (GAME Console → New Project → API Key)
VIRTUALS_API_KEY=your-virtuals-game-api-key
# Unibase: https://unibase.io (requires BNB testnet wallet)
MEMBASE_ID=0xclaw-main
MEMBASE_ACCOUNT=your-bnb-wallet-address
MEMBASE_SECRET_KEY=your-membase-secret-key
