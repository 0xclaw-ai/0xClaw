# 0xClaw Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# === PRIMARY INFERENCE (Z.ai — Gold Sponsor) ===
# International API: https://api.z.ai/api/paas/v4
# Get your key at: https://z.ai/model-api
ZAI_API_KEY=your-zai-api-key

# === SECONDARY INFERENCE (FLock.io — Gold Sponsor) ===
# Get your key at: https://platform.flock.io
FLOCK_API_KEY=sk-your-flock-api-key

# === WEB SEARCH (optional) ===
# Get from: https://api.search.brave.com
BRAVE_API_KEY=your-brave-search-api-key

# === ACP / CLAUDE CODE (no API key required here) ===
# Install and log in separately:
#   npm install -g acpx @anthropic-ai/claude-code
#   claude
# Then set `subagents.coding.backend` to `claude_code` in `0xclaw/config/config.json`.

# === GATEWAY ===
TELEGRAM_BOT_TOKEN=your-token
