{
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": "minimax-m2.5",
      "provider": "flock",
      "maxTokens": 8192,
      "temperature": 0.1,
      "maxToolIterations": 50,
      "memoryWindow": 100
    }
  },
  "providers": {
    "custom": {
      "apiKey": "${ZAI_API_KEY}",
      "apiBase": "https://open.bigmodel.cn/api/paas/v4/"
    },
    "zhipu": {
      "apiKey": "${ZAI_API_KEY}",
      "apiBase": "https://open.bigmodel.cn/api/paas/v4/"
    },
    "flock": {
      "apiKey": "${FLOCK_API_KEY}",
      "apiBase": "https://api.flock.io/v1",
      "extraHeaders": {
        "x-litellm-api-key": "${FLOCK_API_KEY}"
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "bridgeUrl": "ws://localhost:3001",
      "bridgeToken": "${WHATSAPP_BRIDGE_TOKEN}",
      "allowFrom": []
    },
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": [],
      "replyToMessage": true
    }
  },
  "tools": {
    "exec": {
      "timeout": 120
    },
    "web": {
      "search": {
        "apiKey": "${BRAVE_API_KEY}"
      }
    }
  },
  "gateway": {
    "heartbeat": {
      "enabled": true,
      "intervalS": 21600
    }
  }
}
