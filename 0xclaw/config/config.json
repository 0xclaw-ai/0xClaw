{
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": "glm-5.1",
      "provider": "zhipu",
      "maxTokens": 8192,
      "temperature": 0.1,
      "maxToolIterations": 200,
      "memoryWindow": 100
    }
  },
  "providers": {
    "custom": {
      "apiKey": "${ZAI_API_KEY}",
      "apiBase": "https://api.z.ai/api/paas/v4"
    },
    "zhipu": {
      "apiKey": "${ZAI_API_KEY}",
      "apiBase": "https://api.z.ai/api/paas/v4"
    },
    "flock": {
      "apiKey": "${FLOCK_API_KEY}",
      "apiBase": "https://api.flock.io/v1",
      "extraHeaders": {
        "x-litellm-api-key": "${FLOCK_API_KEY}"
      }
    }
  },
  "subagents": {
    "coding": {
      "backend": "claude_code",
      "fallbackBackend": "default_llm"
    },
    "testing": {
      "backend": "claude_code",
      "fallbackBackend": "default_llm",
      "sandbox": "e2b"
    },
    "claudeCode": {
      "model": "",
      "cwd": "./workspace/hackathon/project",
      "timeoutSec": 1800,
      "permissionMode": "acceptEdits",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "authTokenEnv": "ZAI_API_KEY"
    },
    "e2b": {
      "apiKeyEnv": "E2B_API_KEY",
      "template": "claude",
      "timeoutSec": 1800
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "bridgeUrl": "ws://localhost:3001",
      "bridgeToken": "${WHATSAPP_BRIDGE_TOKEN}",
      "allowFrom": []
    },
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": [],
      "replyToMessage": true
    }
  },
  "tools": {
    "exec": {
      "timeout": 120
    },
    "web": {
      "search": {
        "apiKey": "${BRAVE_API_KEY}"
      }
    },
    "mcp_servers": {
      "firecrawl": {
        "command": "npx",
        "args": ["-y", "firecrawl-mcp"],
        "env": {
          "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
        },
        "tool_timeout": 120
      }
    }
  },
  "gateway": {
    "heartbeat": {
      "enabled": true,
      "intervalS": 21600
    }
  }
}
